APP_NAME=CertiTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- MySQL (create the database first, see README) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=certitrack
DB_USERNAME=certitrack
DB_PASSWORD=change_me_db_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Browser dashboards call the API with the web session cookie (Sanctum stateful mode).
# Must contain host:port exactly as typed in the browser address bar.
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000
